# Cloudflare Pages static response rules. HTML uses Pages' revalidation defaults.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://formsubmit.co; upgrade-insecure-requests

# These directories contain fingerprinted assets in the Cloudflare build.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable
/videos/*
  Cache-Control: public, max-age=31536000, immutable

# Downloads retain their readable names and must be revalidated.
/downloads/*
  Cache-Control: public, max-age=0, must-revalidate

# Keep Pages aliases and previews out of search; the custom domain stays indexable.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
/404
  X-Robots-Tag: noindex
